# BRMG On-Chain Royalties — environment template.
# Copy to ~/.brmg-factory.env and fill in. NEVER commit the filled file (.gitignore covers .env*).

# ---- Story chain wallet (also set in story-sdk-mcp/.env) ----
WALLET_PRIVATE_KEY=           # hot wallet that registers IP + pays gas (fund with a little IP)
RPC_PROVIDER_URL=https://mainnet.storyrpc.io

# ---- BRMG catalog collection (Story mainnet) ----
BRMG_SPG_CONTRACT=0x020CE1b10Ce744Fc876633fD4B8b3b06fC426c76

# ---- Hosting: Pinata (--backend ipfs) ----
PINATA_JWT=                   # optional; account must allow pins

# ---- Hosting: Storj S3 + public linkshare (--backend storj, recommended) ----
STORJ_ACCESS_KEY_ID=
STORJ_SECRET_ACCESS_KEY=
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_BUCKET=crabby
STORJ_PUBLIC_LINKSHARE_KEY=   # public read grant for the bucket
STORJ_PREFIX=brmg

# ---- Polygon verification (Phase 0 utility token; Etherscan V2 multichain) ----
ETHERSCAN_API_KEY=            # works across chains via api.etherscan.io/v2/api?chainid=137
